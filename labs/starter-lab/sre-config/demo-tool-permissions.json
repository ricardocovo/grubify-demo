{
  "allow": [
    "ManageTodoList",
    "ReadFile",
    "Grep",
    "GrepSearch",
    "Glob",
    "SearchTools",
    "SearchTool",
    "SearchMemory",
    "RunAzCliReadCommands",
    "GetAzCliHelp",
    "QueryLogAnalyticsByWorkspaceId",
    "QueryAppInsightsByResourceId",
