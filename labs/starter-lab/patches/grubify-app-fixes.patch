diff --git a/scripts/verify-app.ps1 b/scripts/verify-app.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..f412b39f0a925215124a898cccda966f6f4d3379
--- /dev/null
+++ b/scripts/verify-app.ps1
@@ -0,0 +1,91 @@
+#Requires -Version 7.0
+param(
+    [Parameter(Mandatory)]
+    [uri]$BaseUrl,
+    [ValidateRange(1, 200)]
+    [int]$CartRequests = 150
+)
+
+$ErrorActionPreference = 'Stop'
+$base = $BaseUrl.AbsoluteUri.TrimEnd('/')
+$user = "verification-$([guid]::NewGuid().ToString('N'))"
+$checks = 0
+
+function Assert-Equal($Actual, $Expected, [string]$Description) {
+    if ($Actual -ne $Expected) {
+        throw "${Description}: expected '$Expected', got '$Actual'"
+    }
+    $script:checks++
+}
+
+function Send-Request([string]$Path, [string]$Method = 'Get', $Body = $null) {
+    $parameters = @{
+        Uri = "$base$Path"
+        Method = $Method
+        TimeoutSec = 30
+        SkipHttpErrorCheck = $true
+        MaximumRedirection = 0
+    }
+    if ($null -ne $Body) {
+        $parameters.ContentType = 'application/json'
+        $parameters.Body = $Body | ConvertTo-Json -Depth 12
+    }
+    Invoke-WebRequest @parameters
+}
+
+try {
+    Assert-Equal (Send-Request '/health').StatusCode 200 'Health'
+    Assert-Equal (Send-Request '/api/restaurants').StatusCode 200 'Restaurants'
+    Assert-Equal (Send-Request '/api/fooditems/restaurant/1').StatusCode 200 'Menu'
+    for ($i = 1; $i -le $CartRequests; $i++) {
+        $response = Send-Request "/api/cart/$user/items" 'Post' @{ foodItemId = 1; quantity = 1 }
+        Assert-Equal $response.StatusCode 200 "Cart request $i"
+    }
+    $cart = (Send-Request "/api/cart/$user").Content | ConvertFrom-Json
+    Assert-Equal $cart.items[0].quantity $CartRequests 'Accumulated quantity'
+    $id = $cart.items[0].id
+    Assert-Equal (Send-Request "/api/cart/$user/items/$id" 'Put' @{ quantity = 1 }).StatusCode 200 'Update quantity'
+    $cart = (Send-Request "/api/cart/$user").Content | ConvertFrom-Json
+    Assert-Equal $cart.total 21.34 'Cart total'
+    Assert-Equal (Send-Request "/api/cart/$user/items" 'Post' @{ foodItemId = 999; quantity = 1 }).StatusCode 400 'Unknown food rejected'
+    Assert-Equal (Send-Request "/api/cart/$user/items/$id" 'Put' @{ quantity = 0 }).StatusCode 400 'Invalid quantity rejected'
+
+    $body = @{
+        userId = $user
+        restaurantId = 1
+        items = $cart.items
+        deliveryAddress = '1 Verification Way'
+        customerPhone = '2025550100'
+        paymentMethod = 'cash-on-delivery'
+    }
+    # Prices and restaurant metadata must come from the server, not the client.
+    $body.items[0].foodItem.price = 0
+    $response = Send-Request '/api/orders' 'Post' $body
+    Assert-Equal $response.StatusCode 201 'Checkout'
+    $order = $response.Content | ConvertFrom-Json
+    Assert-Equal $order.total 21.34 'Order total'
+    Assert-Equal $order.subTotal $cart.subTotal 'Subtotal matches cart'
+    Assert-Equal $order.tax $cart.tax 'Tax matches cart'
+    Assert-Equal $order.deliveryFee $cart.deliveryFee 'Delivery fee matches cart'
+    Assert-Equal $order.restaurant.name "Tony's Italian Bistro" 'Restaurant details'
+    Assert-Equal $order.customerPhone '2025550100' 'Customer phone'
+    Assert-Equal ($order.estimatedDeliveryTime -gt 0) $true 'Delivery estimate'
+    $location = [string]$response.Headers.Location
+    Assert-Equal ($location.StartsWith('/api/', [StringComparison]::OrdinalIgnoreCase)) $true 'Relative order location'
+    Assert-Equal (Send-Request $location).StatusCode 200 'Order tracking'
+    $cancel = Send-Request "/api/orders/$($order.id)/cancel" 'Put'
+    Assert-Equal $cancel.StatusCode 200 'Cancellation'
+    Assert-Equal (($cancel.Content | ConvertFrom-Json).status) 7 'Cancelled status'
+    Start-Sleep -Seconds 32
+    $cancelled = (Send-Request "/api/orders/$($order.id)").Content | ConvertFrom-Json
+    Assert-Equal $cancelled.status 7 'Cancellation survives scheduled confirmation'
+
+    $body.items = @()
+    Assert-Equal (Send-Request '/api/orders' 'Post' $body).StatusCode 400 'Empty order rejected'
+    Assert-Equal (Send-Request "/api/cart/$user/items/$id" 'Delete').StatusCode 200 'Remove cart item'
+    $empty = (Send-Request "/api/cart/$user").Content | ConvertFrom-Json
+    Assert-Equal $empty.items.Count 0 'Cart emptied'
+    Write-Output "PASS: $checks assertions, $CartRequests cart requests, checkout, tracking and cancellation."
+} finally {
+    Assert-Equal (Send-Request "/api/cart/$user" 'Delete').StatusCode 200 'Verification cart cleanup'
+}
